# Скопируйте в .env (cp .env.example .env && chmod 600 .env) и заполните. Файл .env в git не попадает.
# Токен бота от @BotFather (секрет).
TELEGRAM_BOT_TOKEN=
# api_id с my.telegram.org, «API development tools» (только для telegram-bot-api).
TELEGRAM_API_ID=
# api_hash оттуда же (секрет).
TELEGRAM_API_HASH=
# Домен, по которому Traefik отдаёт сервер раннеру, без https:// и без слэша, например cs2.example.com.
CS2_DOMAIN=
# Имя внешней docker-сети, в которой работает ваш Traefik (docker network ls), например proxy.
TRAEFIK_NETWORK=
# Точка входа HTTPS в вашем Traefik; пусто — websecure.
TRAEFIK_ENTRYPOINT=
# Имя certresolver в вашем Traefik (certificatesResolvers.<имя>), например letsencrypt.
TRAEFIK_CERTRESOLVER=
